# Copy this file to `.env` and fill in what you need.
# The .env file is git-ignored so nothing here is ever committed.

# Optional — lets the phone quick-add endpoint understand free text like
# "twelve fifty for lunch at Chipotle". Structured entries work without it.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — signs login cookies. If blank, one is generated in data/secret_key.
FINANCE_SECRET_KEY=

# Where the server listens. Keep 127.0.0.1 and use `tailscale serve` (see README).
FINANCE_HOST=127.0.0.1
FINANCE_PORT=5050
